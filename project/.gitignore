# Environment variable files — may contain secrets
.env
.env.*
!.env.example
# Build-time default for production. Holds only the public Function URL, which
# ships in the client bundle anyway, so it is safe to commit. Secrets stay in
# the untracked .env.local and in the Function environment.
!.env.production

# Dependencies & Build Output
node_modules/
dist/
# pnpm is the canonical package manager — ignore the npm lockfile
package-lock.json

# Tooling and IDE caches
.commandcode/
.kilo/
.DS_Store
__pycache__/
*.py[cod]

# Temporary visual regression profiles & screenshots
chrome-profile-debug/
*.png

# Test coverage
testsprite_tests/tmp/config.json
coverage/
coverage-data/
coverage-targeted/

# Playwright e2e artifacts
playwright-report/
test-results/
