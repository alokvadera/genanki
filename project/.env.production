# Production build default. Vite loads this file for `vite build`, so the
# frontend has a working API URL even when the build environment defines no
# VITE_API_URL (for example, a fresh Cloudflare Pages project).
#
# This value is public: it ends up in the client bundle either way. Secrets
# belong in project/.env.local (untracked) and in the Neon Function env.
#
# Precedence: .env.local > .env.production > .env
# Override per environment by setting VITE_API_URL in the Cloudflare Pages
# dashboard, which takes priority over this default at build time.
VITE_API_URL=https://br-super-river-ayazioha-api.compute.c-5.us-east-2.aws.neon.tech
