# genanki API — server-side environment for `neon deploy --env .env.local`
# Copy to .env.local and fill in. NEVER commit .env.local (already gitignored).
# DATABASE_URL is injected automatically by `neon deploy` from the linked
# Neon branch — do not put it here unless deploying outside the CLI.

# ---------------------------------------------------------------------------
# Required secrets — deploy fails closed if missing
# ---------------------------------------------------------------------------

# Long random string. Derives the per-visitor AES-256-GCM key for the
# zero-knowledge run history (server/encryption.ts).
ENCRYPTION_PEPPER=generate-a-long-random-string-here

# Admin console passphrase for /api/admin/* endpoints (server/services/ipRateLimiter.ts).
ADMIN_SECRET=generate-another-long-random-string

# ---------------------------------------------------------------------------
# AI provider keys — all optional; an absent key disables that provider
# ---------------------------------------------------------------------------

GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=genanki
OPENROUTER_APP_URL=https://your-app.pages.dev

# Kilo Gateway (free models)
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_MODEL_IDS=kilo-auto/free,openrouter/free

# Cloudflare Workers AI (10,000 neurons/day free)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL_IDS=@cf/meta/llama-3.2-3b-instruct,@cf/qwen/qwen3-30b-a3b-fp8,@cf/meta/llama-3.1-8b-instruct-fp8-fast
# Optional: override the default 10,000 neuron daily budget
CLOUDFLARE_DAILY_NEURON_BUDGET=10000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated origins of the frontend (Cloudflare Pages URL + localhost
# for dev). Leave empty to allow all origins (fine for early testing).
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.pages.dev

# ---------------------------------------------------------------------------
# Optional logging
# ---------------------------------------------------------------------------
# LOG_LEVEL=info
# LOG_REDACT=true
