{
  "name": "genanki-monorepo",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "pnpm --filter genanki dev",
    "build": "pnpm --filter genanki build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deploy:web": "pnpm --filter genanki deploy",
    "deploy:api": "neon deploy --env .env.local",
    "db:generate": "pnpm --filter genanki-server db:generate",
    "db:migrate": "pnpm --filter genanki-server db:migrate"
  },
  "dependencies": {
    "@neon/config": "^1.3.2",
    "@neon/env": "^1.2.3"
  }
}
